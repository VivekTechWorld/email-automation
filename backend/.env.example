OLLAMA_BASE_URL=http://localhost:11434

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token required on all API routes except /health
API_KEY=changeme-secret-api-key-2026

# Shared passphrase for the React dashboard login screen
DASHBOARD_PASSWORD=admin123

# ── AI Provider Toggle ──────────────────────────────────────────────────────
# Choose: "local" (Ollama) or "gemini" (Google Gemini 1.5 Flash)
# Can be changed at runtime via /set-provider endpoint — no restart needed.
AI_PROVIDER=local

# Google Gemini API Key (only needed when AI_PROVIDER=gemini)
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Call 1 — classification model (fine-tuned for ArtCloud email categorisation)
# Determines: category, severity, language, confidence, needs_context
LLM_MODEL=email-support-v2

# Call 2 — generation model (writes the actual customer reply using RAG context)
RAG_MODEL=qwen2.5:7b

# Embeddings model used for ChromaDB ingestion and retrieval
EMBED_MODEL=nomic-embed-text

# Path where ChromaDB stores its vector data
CHROMA_PERSIST_DIR=../data/chroma_db

# Path to the knowledge base directory
# Files must follow the naming convention: {basename}-{lang_code}.{ext}
# Examples: artcloud-data-en.txt, artcloud-data-fi.txt
KNOWLEDGE_BASE_DIR=../data/knowledge_base

# Where critical-severity alerts are forwarded (human review)
ALERT_EMAIL=your@email.com

# The support inbox address (for reference/logging)
SUPPORT_EMAIL=support@yourcompany.com

# Sign-off name used in every auto-reply and alert email
COMPANY_NAME=Support Team

# Minimum confidence score (1-5) from the classifier before RAG is triggered
# Lower = more RAG calls (safer but slower). Recommended: 2-3
MIN_CONFIDENCE_THRESHOLD=2

# Fallback language when classifier cannot determine the email language (ISO 639-1)
DEFAULT_LANG=en
