OLLAMA_HOST=http://localhost:11434

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token for machine clients (n8n, scripts). Never put it in the frontend.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Dashboard login password — checked by the backend (POST /auth/login)
DASHBOARD_PASSWORD=

# Optional: separate secret for signing dashboard sessions (defaults to API_KEY)
SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to false in production to hide /docs and /openapi.json
ENABLE_API_DOCS=true

# ── AI Provider Toggle ──────────────────────────────────────────────────────
# Choose: "local" (Ollama) or "gemini" (Google Gemini)
# Can be changed at runtime via /set-provider endpoint — no restart needed.
AI_PROVIDER=gemini

# Gemini models tried in order (falls back to the next one on overload/errors)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-latest

# Google Gemini API Key (only needed when AI_PROVIDER=gemini)
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Call 1 — classification model (fine-tuned for ArtCloud email categorisation)
# Determines: category, severity, language, confidence, needs_context
LLM_MODEL=email-support-v2

# Call 2 — generation model (writes the actual customer reply using RAG context)
RAG_MODEL=qwen2.5:7b

# Embeddings model used for ChromaDB ingestion and retrieval
EMBED_MODEL=nomic-embed-text

# Path where ChromaDB stores its vector data
CHROMA_PERSIST_DIR=../data/chroma_db

# Seed files imported ONCE into the dashboard knowledge base on first start.
# After that, manage knowledge from the dashboard (Knowledge base tab).
KNOWLEDGE_BASE_DIR=../data/knowledge_base

# Where critical-severity alerts are forwarded (human review)
ALERT_EMAIL=your@email.com

# The support inbox address (for reference/logging)
SUPPORT_EMAIL=support@yourcompany.com

# Sign-off name used in every auto-reply and alert email
COMPANY_NAME=Support Team

# Who the AI is answering for (used in classification + reply prompts)
COMPANY_DESCRIPTION=ArtCloud, a web hosting company

# Minimum keyword-match score for knowledge-base fallback retrieval (when ChromaDB is unavailable)
KEYWORD_RAG_MIN_SCORE=2.5

# Minimum confidence score (1-5) from the classifier before RAG is triggered
# Lower = more RAG calls (safer but slower). Recommended: 2-3
MIN_CONFIDENCE_THRESHOLD=2

# Fallback language when classifier cannot determine the email language (ISO 639-1)
DEFAULT_LANG=en

# Path for persisted email processing logs (SQLite store)
EMAIL_DB_PATH=../data/email_logs.db

# ── Human Review Queue & Notifications ─────────────────────────────────────
# Minimum confidence score before queuing for human review (default: 2)
REVIEW_CONFIDENCE_THRESHOLD=2

# Webhook URL for Slack/Teams/Discord alerts on critical or pending emails (optional)
ALERT_WEBHOOK_URL=

# Initial defaults for the dashboard Settings page (changes made there win):
# hours before an unreviewed held email gets the AI draft sent automatically (0 = never)
PENDING_REVIEW_TIMEOUT_HOURS=24
# address notified when a sales (or other handed-off) email arrives
SALES_TEAM_EMAIL=

# ── Knowledge base limits (keep prompts within the model's context) ────────
KB_MAX_ARTICLE_CHARS=15000
KB_CHUNK_CHARS=900
KB_MAX_TOTAL_CHUNKS=500
# max knowledge-base characters sent to the model per email
RAG_CONTEXT_MAX_CHARS=6000

# ── Customer profiles & reports ─────────────────────────────────────────────
# Max characters of a customer profile sent to the AI per email (keeps prompts small)
PROFILE_MAX_CHARS=900
# Initial recipient for the automatic report (can be changed in Settings)
REPORT_EMAIL=
