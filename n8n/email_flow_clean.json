        "subject": "=[{{ $json.category.toUpperCase() }} handoff] {{ $json.subject }}",
        "emailType": "html",
        "message": "=<html><body style=\"font-family:sans-serif;color:#1f2a37\"><h2 style=\"color:#4f6bdc\">New {{ $json.category }} email for your team</h2><p><b>From:</b> {{ $json.sender }}<br/><b>Subject:</b> {{ $json.subject }}<br/><b>Summary:</b> {{ $json.summary }}</p><h3>Customer message</h3><blockquote style=\"border-left:4px solid #4f6bdc;padding-left:12px;white-space:pre-wrap\">{{ $json.original_body }}</blockquote><h3>AI draft (waiting in the Review queue)</h3><blockquote style=\"border-left:4px solid #9aa6b8;padding-left:12px;white-space:pre-wrap\">{{ $json.body }}</blockquote><p style=\"color:#5b6b7f\">{{ $json.review_reason }}. Open the dashboard Review queue to edit, approve or reject.</p></body></html>",
        "options": {
          "appendAttribution": false
