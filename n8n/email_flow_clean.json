        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false,
          "replyToSenderOnly": true
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        320,
        140
      ],
      "id": "a1b2c3d4-0005-0000-0000-000000000005",
      "name": "Send Auto Reply",
      "credentials": {
        "gmailOAuth2": {
          "id": "paT1SdYpVSmTE3T4",
          "name": "Gmail account"
        }
      }
    },
    {
